# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Resend API key (https://resend.com → API Keys). Used by the contact form.
RESEND_API_KEY=

# Where contact form submissions are sent.
CONTACT_TO_EMAIL=

# Optional. Sender shown in the email. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which can only send to the email you signed up to Resend with.
# After verifying your own domain in Resend, use e.g. "Cron Website <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
